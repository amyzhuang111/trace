Section J — SQL evidence

Show two SQL cards.

Query 1 — cohort repeat

WITH first_orders AS (
  SELECT
    customer_id,
    MIN(order_date) AS first_order_date
  FROM orders
  GROUP BY 1
),
cohorts AS (
  SELECT
    f.customer_id,
    DATE_TRUNC('month', f.first_order_date) AS cohort_month,
    a.acquisition_channel,
    f.first_order_date
  FROM first_orders f
  LEFT JOIN acquisition a USING (customer_id)
)
SELECT
  cohort_month,
  acquisition_channel,
  COUNT(DISTINCT customer_id) AS customers,
  AVG(
    CASE WHEN second_order_date <= first_order_date + INTERVAL '30 day'
    THEN 1 ELSE 0 END
  ) AS repeat_30d
FROM cohort_features
GROUP BY 1, 2
ORDER BY 1, 2;

